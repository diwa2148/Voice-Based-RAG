# Voice-Enabled RAG System Configuration

# Sarvam AI API (Speech-to-Text & LLM)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_LLM_ENDPOINT=https://api.sarvam.ai/v1/chat/completions
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b

# Hugging Face Inference API / Hosted Embeddings & Reranker
HF_TOKEN=your_huggingface_token_here
EMBEDDING_API_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/BAAI/bge-m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

RERANKER_API_URL=https://api-inference.huggingface.co/models/BAAI/bge-reranker-v2-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_cloud
QDRANT_COLLECTION_NAME=msmarco_xi_chunks
QDRANT_STORAGE_DIR=./qdrant_data

# Retrieval & Guardrails Configuration
DEFAULT_CHUNKING_STRATEGY=auto
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
MIN_RETRIEVAL_SCORE=0.35
ENABLE_RERANKER=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
